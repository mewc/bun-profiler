{
  "name": "bun-profiler",
  "version": "0.4.4",
  "description": "Continuous CPU profiling for Bun (JavaScriptCore) via Pyroscope/Grafana ingest — zero native dependencies",
  "author": {
    "name": "mewc",
    "url": "https://x.com/the_mewc"
  },
  "homepage": "https://github.com/mewc/bun-profiler#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mewc/bun-profiler.git"
  },
  "bugs": {
    "url": "https://github.com/mewc/bun-profiler/issues"
  },
  "license": "MIT",
  "keywords": [
    "bun",
    "pyroscope",
    "profiling",
    "continuous-profiling",
    "flamegraph",
    "apm",
    "observability",
    "javascriptcore",
    "jsc",
    "grafana"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./preload": {
      "import": "./dist/preload.js",
      "types": "./dist/preload.d.ts"
    },
    "./experimental": {
      "import": "./dist/experimental.js",
      "types": "./dist/experimental.d.ts"
    }
  },
  "bin": {
    "bun-profiler": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:esm && bun run build:cjs && bun run build:types",
    "build:esm": "bun build ./src/index.ts ./src/preload.ts ./src/cli.ts ./src/experimental.ts --outdir ./dist --format esm --target node --external node:inspector --external node:os --external node:zlib --external node:util --external node:fs/promises --external node:child_process --external node:url --external node:worker_threads",
    "build:cjs": "bun build ./src/index.ts --outfile ./dist/index.cjs --format cjs --target node --external node:inspector --external node:os --external node:zlib --external node:util",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "l": "bun run typecheck && bun run lint && bun test",
    "dev": "dev/up.sh",
    "dev:demo": "dev/up.sh --load",
    "dev:down": "dev/down.sh",
    "dev:logs": "dev/compose.sh logs -f app",
    "dev:restart": "dev/compose.sh restart app",
    "dev:load": "dev/loadgen.sh",
    "dev:reset": "dev/down.sh && dev/up.sh",
    "screenshots": "dev/screenshots.sh",
    "dev:alloy": "dev/up.sh --alloy",
    "dev:failures": "dev/failures.sh",
    "dev:workers": "dev/workers.sh",
    "dev:otlp": "dev/up.sh --otlp",
    "bench": "dev/bench.sh",
    "smoke": "bun smoke-test.ts",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "prepublishOnly": "bun run build && bun run l"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@types/node": "^25.3.0",
    "playwright": "^1.62.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "protobufjs": "^7.6.5"
  },
  "engines": {
    "bun": ">=1.3.7"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
