pyroscope.receive_http "bun_profiler" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 9999
  }
  forward_to = [
    pyroscope.write.primary.receiver,
    pyroscope.write.secondary.receiver,
  ]
}

pyroscope.write "primary" {
  endpoint {
    url = "http://pyroscope-primary:4040"
  }
}

pyroscope.write "secondary" {
  endpoint {
    url = "http://pyroscope-secondary:4040"
  }
}
